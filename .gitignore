# MindMux client runtime artifacts (task logs, etc.) — not part of the product
.mindmux/

# macOS
.DS_Store

# Local brain.md wiring for working ON this repo. The canonical contract + skeleton
# ship in skills/brain-setup/assets/; these root copies are local-only, not product.
/BRAIN.md
/CLAUDE.md

# VS Code / code-server extension build artifacts — derived from extension/src
# and skills/, not checked in. CI publishes a versioned .vsix as a GitHub
# Release on every push to main that touches a build input (see
# .github/workflows/extension-release.yml) — these stay build output only,
# never committed.
/extension/node_modules/
/extension/out/
/extension/assets/
/extension/dist/
/extension/*.vsix
